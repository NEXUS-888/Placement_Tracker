# Placement Tracker Configuration

# 1. Google Gemini API Key (get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Discord Webhook URL (create in Discord Channel -> Edit Channel -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# 3. Server Configuration
PORT=8000
HOST=127.0.0.1

# 4. WhatsApp Configuration (Name or partial name of your college placement group)
TARGET_WHATSAPP_GROUP=Placement
